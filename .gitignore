# Capacitor — os projetos android/ e ios/ ficam versionados (sao parte do
# app), mas os artefatos de build e config local de cada maquina, nao.
android/app/build
android/build
android/.gradle
android/local.properties
android/captures
android/*.iml
android/.idea
ios/App/Pods
ios/App/build
